---
/**
 * Footer de Presentation Studio PTY.
 * Cambia los datos de contacto aquí arriba; el resto no necesita edición.
 */
const contacto = {
  instagram: "https://instagram.com/TU_USUARIO", // <- tu usuario de Instagram
  instagramUser: "@tu_usuario",
  whatsapp: "50700000000", // <- número con código de país, sin + ni espacios (507 = Panamá)
  whatsappDisplay: "+507 0000-0000",
  email: "contacto@tudominio.com", // <- tu correo
  ubicacion: { es: "Panamá", en: "Panama" },
};

const mensaje = encodeURIComponent("Hola, me gustaría cotizar una producción.");
const whatsappUrl = `https://wa.me/${contacto.whatsapp}?text=${mensaje}`;
const year = new Date().getFullYear();
---

<footer id="contacto" class="w-full bg-black text-white border-t border-white/30">
  <div class="w-full max-w-5xl mx-auto px-5">

    <!-- Llamado a la acción -->
    <div class="flex flex-col items-start gap-8 py-16 sm:flex-row sm:items-end sm:justify-between">
      <h2
        class="font-display text-4xl sm:text-6xl font-bold italic uppercase tracking-wide leading-none"
        data-es="¿Tienes un proyecto en mente?"
        data-en="Have a project in mind?"
      >
        ¿Tienes un proyecto en mente?
      </h2>

      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="shrink-0 inline-flex items-center gap-3 border border-white px-6 py-3 font-semibold
               transition duration-300 hover:bg-white hover:text-black
               focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-white"
      >
        <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
          <path d="M20.52 3.48A11.86 11.86 0 0 0 12.04 0C5.5 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.59 5.93L0 24l6.4-1.68a11.8 11.8 0 0 0 5.64 1.44h.01c6.54 0 11.84-5.3 11.84-11.84 0-3.16-1.23-6.13-3.37-8.44ZM12.05 21.77h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.8 1 1.01-3.7-.24-.38a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 7c0 5.45-4.44 9.89-9.83 9.89Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
        </svg>
        <span data-es="Escríbenos por WhatsApp" data-en="Message us on WhatsApp">Escríbenos por WhatsApp</span>
      </a>
    </div>

    <!-- Columnas -->
    <div class="grid grid-cols-1 gap-10 border-t border-white/30 py-12 sm:grid-cols-3">

      <div>
        <p class="font-display text-2xl font-bold italic uppercase tracking-wide">Presentation Studio PTY</p>
        <p
          class="mt-3 max-w-xs text-white/70"
          data-es="Producción audiovisual: videos, comerciales y fotografía."
          data-en="Audiovisual production: videos, commercials and photography."
        >
          Producción audiovisual: videos, comerciales y fotografía.
        </p>
      </div>

      <nav aria-label="Navegación del sitio">
        <h3 class="font-display text-lg font-bold italic uppercase tracking-wide" data-es="Explora" data-en="Explore">Explora</h3>
        <ul class="mt-3 flex flex-col gap-2 text-white/70">
          <li>
            <a href="#producciones" class="transition hover:text-white hover:underline underline-offset-4" data-es="Producciones" data-en="Productions">Producciones</a>
          </li>
          <li>
            <a href="#servicios" class="transition hover:text-white hover:underline underline-offset-4" data-es="Servicios" data-en="Services">Servicios</a>
          </li>
          <li>
            <a href="#contacto" class="transition hover:text-white hover:underline underline-offset-4" data-es="Contacto" data-en="Contact">Contacto</a>
          </li>
        </ul>
      </nav>

      <div>
        <h3 class="font-display text-lg font-bold italic uppercase tracking-wide" data-es="Contacto" data-en="Contact">Contacto</h3>
        <ul class="mt-3 flex flex-col gap-2 text-white/70">
          <li>
            <a
              href={contacto.instagram}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 transition hover:text-white hover:underline underline-offset-4"
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1" class="fill-current stroke-none" />
              </svg>
              {contacto.instagramUser}
            </a>
          </li>
          <li>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 transition hover:text-white hover:underline underline-offset-4"
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-current" aria-hidden="true">
                <path d="M20.52 3.48A11.86 11.86 0 0 0 12.04 0C5.5 0 .2 5.3.2 11.84c0 2.09.55 4.13 1.59 5.93L0 24l6.4-1.68a11.8 11.8 0 0 0 5.64 1.44h.01c6.54 0 11.84-5.3 11.84-11.84 0-3.16-1.23-6.13-3.37-8.44ZM12.05 21.77h-.01a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.8 1 1.01-3.7-.24-.38a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.89 9.9-9.89 2.64 0 5.12 1.03 6.99 2.9a9.82 9.82 0 0 1 2.89 7c0 5.45-4.44 9.89-9.83 9.89Zm5.42-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.46-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.8.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.22 3.08.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.7.63.71.23 1.36.2 1.87.12.57-.08 1.76-.72 2-1.41.25-.7.25-1.29.17-1.41-.07-.13-.27-.2-.57-.35Z"/>
              </svg>
              {contacto.whatsappDisplay}
            </a>
          </li>
          <li>
            <a
              href={`mailto:${contacto.email}`}
              class="inline-flex items-center gap-2 transition hover:text-white hover:underline underline-offset-4"
            >
              <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
              {contacto.email}
            </a>
          </li>
          <li class="inline-flex items-center gap-2">
            <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current" stroke-width="1.8" aria-hidden="true">
              <path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" />
              <circle cx="12" cy="9.5" r="2.5" />
            </svg>
            <span data-es={contacto.ubicacion.es} data-en={contacto.ubicacion.en}>{contacto.ubicacion.es}</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- Línea final -->
    <div class="flex flex-col gap-4 border-t border-white/30 py-6 text-sm text-white/50 sm:flex-row sm:items-center sm:justify-between">
      <p>
        © {year} Presentation Studio PTY.
        <span data-es="Todos los derechos reservados." data-en="All rights reserved.">Todos los derechos reservados.</span>
      </p>
      <a href="#" class="transition hover:text-white" data-es="Volver arriba ↑" data-en="Back to top ↑">Volver arriba ↑</a>
    </div>
  </div>
</footer>