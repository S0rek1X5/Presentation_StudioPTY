---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import "@fontsource/barlow-condensed/700-italic.css";
import "@fontsource/barlow-condensed/400.css";
import "@fontsource-variable/inter";
---


<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Presentation_StudioPTY</title>
	</head>
	<body class="flex flex-col min-h-screen bg-gray-50 text-gray-900 antialiased">
		<div id="main-header" class="fixed top-0 left-0 w-full z-[110] opacity-0 pointer-events-none transition-opacity duration-700">
			<Header />
		</div>
		<main class="">
      		<slot />
    	</main>
		<Footer/>
	</body>
	
</html>

<script src="../scripts/language.js"></script>
<script src="../scripts/curtain.js"></script>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
	}
</style>